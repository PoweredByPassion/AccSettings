<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="4dp">

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="2dp">

        <Button
            android:id="@+id/widget_pause_30m"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:minHeight="32dp"
            android:text="@string/quick_action_pause_30m"
            android:textSize="12sp" />

        <Button
            android:id="@+id/widget_pause_1h"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:minHeight="32dp"
            android:text="@string/quick_action_pause_1h"
            android:textSize="12sp" />

        <Button
            android:id="@+id/widget_force_full"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:minHeight="32dp"
            android:text="@string/quick_action_force_full"
            android:textSize="12sp" />

        <Button
            android:id="@+id/widget_charge_to_85"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:minHeight="32dp"
            android:text="@string/quick_action_charge_to_85"
            android:textSize="12sp" />

        <Button
            android:id="@+id/widget_cancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="32dp"
            android:text="@string/quick_action_cancel"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
